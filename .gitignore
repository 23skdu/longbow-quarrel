# Go build artifacts.
#
# The pattern used to be "bench*", which also hid the benchmark sources:
# internal/mathx/bench_test.go and internal/mathx/bench_emlgo_test.go were
# never committed, so the A/B harness that docs/performance.md tells the
# reader to run could not be run from a clean checkout.
bench
bench.exe
!scripts/benchmark_engines.sh
!scripts/benchmark_models.sh
!scripts/benchmark_report.py
!scripts/bench_gate.sh
perf*
bin/
comp*
!docs/comparison.md
*.json
!grafana/*.json
!cmd/webui/api/*.yaml
*.exe
*.dll
*.so
*.dylib
*.a
*.test
*.out
coverage.out
*.coverprofile
profile.cov
race_output.txt
engine_race_output.txt
test_output.txt
crash.log

# Go workspace
go.work
go.work.sum

# Local binaries and test executables
/quarrel
/quarrel_bin
/quarrel-metal
/capture_activations
/dump_gguf
/dump_metadata
/dump_tensors
/inspect_gguf
/inspect_vocab
/test_q4k_kernel
/test_q6k_kernel
/main
/gemma4_coherence_test
cmd/webui/webui

# Logs, profiles, and outputs
*.log
*.txt
# The allowlists are part of the gate configuration, not build output.
# Without them in the repository the CI checks that read them fail: the
# documentation drift check reported 74 false problems, because every
# deliberately-allowed Go tool flag looked undocumented.
!scripts/vacuous_tests_allowlist.txt
!scripts/docsync_allowlist.txt
!scripts/dashboard_allowlist.txt
*.prof
*.pprof
*.bin
test.gguf

# Model files (GGUF)
*.gguf
models/*.gguf

# Python artifacts
venv/
__pycache__/
*.pyc

# Env files
.env

# macOS
.DS_Store
bin/
