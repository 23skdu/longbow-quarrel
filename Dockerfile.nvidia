# syntax=docker/dockerfile:1.4
# =============================================================================
# Longbow-Quarrel - Hardened NVIDIA CUDA Build (Compute Capability 8.0 - 9.0+)
# =============================================================================
# DevSecOps Standards:
# - Multi-stage build isolating CUDA developer toolkit from runtime container
# - Go 1.27.2 with deterministic compilation (-trimpath, -ldflags="-s -w")
# - Unprivileged non-root service account (UID 10001)
# - Minimal attack surface with vetted CUDA 12.9 + cuDNN 9 + NCCL runtimes
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: CUDA + CGo Compiler Environment
# -----------------------------------------------------------------------------
FROM nvidia/cuda:12.9.2-devel-ubuntu24.04 AS cuda-builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    --allow-change-held-packages \
    git \
    build-essential \
    pkg-config \
    wget \
    ca-certificates \
    libcudnn9-dev-cuda-12 \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.27.2
ENV GO_VERSION=1.27.2
RUN wget -q https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-amd64.tar.gz && \
    rm go${GO_VERSION}.linux-amd64.tar.gz

ENV PATH=/usr/local/go/bin:/usr/local/cuda/bin:$PATH \
    CUDA_PATH=/usr/local/cuda \
    GO111MODULE=on \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64 \
    CGO_LDFLAGS="-L/usr/local/cuda/lib64 -L/usr/lib/x86_64-linux-gnu -lcudart -lcublas -lcudnn -lnccl" \
    CGO_CFLAGS="-I/usr/local/cuda/include -O3 -fstack-protector-strong"

# Build version metadata, mapped onto main.Version / main.BuildTime in
# cmd/quarrel/version.go.
ARG QUARREL_VERSION=dev
ARG QUARREL_BUILD_TIME=unknown

WORKDIR /src

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Compile CUDA kernels to static library archive
RUN nvcc -c -O3 -Xcompiler -fPIC internal/device/cuda_kernels.cu -o internal/device/cuda_kernels.o && \
    ar rcs internal/device/libcuda_kernels.a internal/device/cuda_kernels.o && \
    rm -f internal/device/cuda_kernels.o

# Build binary with CUDA and NCCL features
RUN go build -trimpath -tags "cuda,nccl" \
    -ldflags="-s -w -X main.Version=${QUARREL_VERSION} -X main.BuildTime=${QUARREL_BUILD_TIME}" \
    -o /out/quarrel ./cmd/quarrel

# -----------------------------------------------------------------------------
# Stage 2: Hardened CUDA Minimal Runtime
# -----------------------------------------------------------------------------
FROM nvidia/cuda:12.9.2-runtime-ubuntu24.04 AS runtime

LABEL org.opencontainers.image.title="Longbow-Quarrel (NVIDIA CUDA)" \
      org.opencontainers.image.description="Accelerated LLM inference engine with CUDA, FlashDecoding, and NCCL" \
      org.opencontainers.image.vendor="Longbow-Quarrel Project" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="nvidia/cuda:12.9.2-runtime-ubuntu24.04"

# Install only necessary runtime shared libraries
# libnccl2 is already installed in this image and is held, so it is not
# listed: installing it would upgrade it to the CUDA 13 candidate, which
# does not match the CUDA 12.9 runtime. cuDNN is not installed, and it
# is held, so the held-package change has to be allowed explicitly.
RUN apt-get update && apt-get install -y --no-install-recommends \
    --allow-change-held-packages \
    ca-certificates \
    libcudnn9-cuda-12 \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged service user and group
RUN groupadd -g 10001 quarrel && \
    useradd -u 10001 -g quarrel -m -s /sbin/nologin quarrel

WORKDIR /app

# Copy CUDA runtime libraries and binary from builder
COPY --from=cuda-builder /usr/local/cuda/lib64/libcudart.so* /usr/local/cuda/lib64/
COPY --from=cuda-builder /usr/lib/x86_64-linux-gnu/libnccl.so* /usr/lib/x86_64-linux-gnu/
COPY --from=cuda-builder --chown=10001:10001 /out/quarrel /app/quarrel
# The builder stage uses WORKDIR /src, so the archive is at /src/..., not /app/...
COPY --from=cuda-builder /src/internal/device/libcuda_kernels.a /usr/local/lib/libcuda_kernels.a

# Set library path
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu \
    PATH=/app:$PATH

# Create models and cache directories with appropriate permissions
RUN mkdir -p /data/models /data/cache && \
    chown -R 10001:10001 /data /app

# Switch to non-root user
USER 10001:10001

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/quarrel", "--version"]

ENTRYPOINT ["/app/quarrel"]
CMD ["--version"]
