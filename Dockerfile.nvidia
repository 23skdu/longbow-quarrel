# =============================================================================
# Longbow-Quarrel - NVIDIA CUDA Build
# =============================================================================
# This Dockerfile builds Quarrel with CUDA + NCCL acceleration for NVIDIA GPUs.
# Requires NVIDIA Container Toolkit for GPU access.
#
# Build:    docker build -f Dockerfile.nvidia -t longbow-quarrel:nvidia .
# Run:      docker run --gpus all -it longbow-quarrel:nvidia --model /data/model.gguf
# =============================================================================

# -----------------------------------------------------------------------------
# Build Stage: CUDA + NCCL Compilation
# -----------------------------------------------------------------------------
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS cuda-builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    pkg-config \
    wget \
    libcudnn9-dev-cuda-12 \
    libnccl2-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Go
RUN wget -q https://go.dev/dl/go1.27.0.linux-amd64.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local -xzf go1.27.0.linux-amd64.tar.gz && \
    rm go1.27.0.linux-amd64.tar.gz

ENV PATH=/usr/local/go/bin:$PATH

# Set environment variables for CUDA
ENV CUDA_PATH=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    GO111MODULE=on

# CGO flags: CUDA + cuBLAS + cuDNN + NCCL
ENV CGO_LDFLAGS="-L/usr/local/cuda/lib64 -L/usr/lib/x86_64-linux-gnu -lcudart -lcublas -lcudnn -lnccl" \
    CGO_CFLAGS="-I/usr/local/cuda/include"

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build with CUDA + NCCL support
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -tags "cuda,nccl" \
    -o quarrel-nvidia ./cmd/quarrel

# -----------------------------------------------------------------------------
# Runtime Stage: Minimal CUDA Runtime
# -----------------------------------------------------------------------------
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

# Install cuDNN + NCCL runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcudnn9-cuda-12 \
    libnccl2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy CUDA library stubs for runtime linking
COPY --from=cuda-builder /usr/local/cuda/lib64/libcudart.so* /usr/local/cuda/lib64/
COPY --from=cuda-builder /usr/local/cuda/lib64/libcuda.so* /usr/lib/x86_64-linux-gnu/

# Copy NCCL library
COPY --from=cuda-builder /usr/lib/x86_64-linux-gnu/libnccl.so* /usr/lib/x86_64-linux-gnu/

# Copy the binary and kernels
COPY --from=cuda-builder /app/quarrel-nvidia ./quarrel
COPY --from=cuda-builder /app/internal/device/libcuda_kernels.so /usr/local/lib/libcuda_kernels.so

# Set library path
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu

# Set default command
CMD ["./quarrel", "--help"]

# =============================================================================
# GPU Requirements
# =============================================================================
# - NVIDIA Driver: 550.54.14+ (for CUDA 12.4)
# - NVIDIA Container Toolkit: v1.16.0+
# - Supported GPUs: Volta, Turing, Ampere, Ada Lovelace, Hopper
#
# Run with GPU access:
#   docker run --gpus all -v /path/to/models:/data longbow-quarrel:nvidia \
#       --model /data/smollm2.gguf --prompt "Hello"
#
# =============================================================================
