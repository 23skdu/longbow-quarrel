# syntax=docker/dockerfile:1.4
# =============================================================================
# Longbow-Quarrel - Hardened CPU Build (SIMD: AVX2/FMA/VNNI)
# =============================================================================
# DevSecOps Standards:
# - Minimal attack surface (multi-stage build, Alpine 3.24)
# - Deterministic compilation (Go 1.27.2, -trimpath, -ldflags="-s -w")
# - Non-root execution (UID 10001)
# - Least privilege container security (read-only rootfs capable)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build Environment
# -----------------------------------------------------------------------------
FROM golang:1.27.2-alpine3.24 AS cpu-builder

RUN apk add --no-cache build-base git ca-certificates

WORKDIR /src

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Compile hardened CPU binary with CGo for runtime SIMD dispatch
ENV CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64 \
    CGO_CPPFLAGS="-D_FORTIFY_SOURCE=2" \
    CGO_CFLAGS="-O3 -fstack-protector-strong"

# Build version metadata. These map onto the main.Version / main.BuildTime
# variables in cmd/quarrel/version.go. The previous `-X main.version=...`
# spelling targeted variables that do not exist, so the linker silently
# dropped the value and every image reported "dev".
ARG QUARREL_VERSION=dev
ARG QUARREL_BUILD_TIME=unknown

RUN go build -trimpath \
    -ldflags="-s -w -X main.Version=${QUARREL_VERSION} -X main.BuildTime=${QUARREL_BUILD_TIME}" \
    -o /out/quarrel ./cmd/quarrel

# -----------------------------------------------------------------------------
# Stage 2: Hardened Minimal Runtime Environment
# -----------------------------------------------------------------------------
FROM alpine:3.24 AS runtime

LABEL org.opencontainers.image.title="Longbow-Quarrel (CPU SIMD)" \
      org.opencontainers.image.description="High-performance zero-copy LLM inference engine with SIMD vectorization" \
      org.opencontainers.image.vendor="Longbow-Quarrel Project" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="alpine:3.24"

# Minimal runtime libraries for CGO-linked binary
RUN apk add --no-cache ca-certificates libstdc++ tzdata && \
    rm -rf /var/cache/apk/*

# Create unprivileged service user and group
RUN addgroup -g 10001 -S quarrel && \
    adduser -u 10001 -S quarrel -G quarrel -h /home/quarrel -s /sbin/nologin

WORKDIR /app

# Copy binary from builder
COPY --from=cpu-builder --chown=10001:10001 /out/quarrel /app/quarrel

# Create persistent storage mountpoints with non-root ownership
RUN mkdir -p /data/models /data/cache && \
    chown -R 10001:10001 /data /app

# Switch to non-root user
USER 10001:10001

# Healthcheck to verify binary integrity
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/app/quarrel", "--version"]

ENTRYPOINT ["/app/quarrel"]
CMD ["--version"]
