# =============================================================================
# Longbow-Quarrel - CPU Build (with SIMD)
# =============================================================================
# This Dockerfile builds Quarrel for CPU with SIMD optimizations (AVX2/AVX-512/NEON).
# Uses CGO for SIMD kernel compilation.
#
# Build:    docker build -f Dockerfile.cpu -t longbow-quarrel:cpu .
# Run:      docker run -v $(pwd)/models:/data longbow-quarrel:cpu --model /data/model.gguf
# =============================================================================

# -----------------------------------------------------------------------------
# Build Stage: CPU Compilation with SIMD
# -----------------------------------------------------------------------------
FROM golang:1.27.0-alpine AS cpu-builder

# Install build dependencies
RUN apk add --no-cache build-base git

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build with CGO enabled for SIMD (auto-detects AVX2/AVX512 at runtime)
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags "-s -w" \
    -o quarrel-cpu ./cmd/quarrel

# -----------------------------------------------------------------------------
# Runtime Stage: Minimal CPU Runtime
# -----------------------------------------------------------------------------
FROM alpine:latest

WORKDIR /app

# Copy binary
COPY --from=cpu-builder /app/quarrel-cpu ./quarrel

# Set default command
CMD ["./quarrel", "--help"]

# =============================================================================
# Build Instructions
# =============================================================================
# Linux (CPU with SIMD):
#   docker build -f Dockerfile.cpu -t longbow-quarrel:cpu .
#   docker run -v $(pwd)/models:/data longbow-quarrel:cpu --model /data/model.gguf
#
# =============================================================================
